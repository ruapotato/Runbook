[configuration]
entry_symbol = "runbook_library_init"
compatibility_minimum = "4.4"

[libraries]
linux.debug.x86_64     = "res://bin/librunbook.linux.x86_64.so"
linux.release.x86_64   = "res://bin/librunbook.linux.x86_64.so"
windows.debug.x86_64   = "res://bin/librunbook.windows.x86_64.dll"
windows.release.x86_64 = "res://bin/librunbook.windows.x86_64.dll"
